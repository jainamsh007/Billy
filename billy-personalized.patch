diff --git a/packages/invoice-core/src/currencies.ts b/packages/invoice-core/src/currencies.ts
index 2159d6f..1547fc4 100644
--- a/packages/invoice-core/src/currencies.ts
+++ b/packages/invoice-core/src/currencies.ts
@@ -29,3 +29,28 @@ export function getCurrencySymbol(code: string): string {
 export function getCurrencyLocale(code: string): string {
   return getCurrency(code).locale
 }
+
+/**
+ * The sign `formatCurrency` actually prints for `code` (several currencies
+ * share "$"), so the invoice can say which one it is.
+ */
+export function getDisplayedSymbol(code: string): string {
+  try {
+    const part = new Intl.NumberFormat(getCurrencyLocale(code), {
+      style: "currency",
+      currency: code,
+    })
+      .formatToParts(0)
+      .find((p) => p.type === "currency")
+    if (part?.value) return part.value
+  } catch {
+    // fall through to the table symbol
+  }
+  return getCurrencySymbol(code)
+}
+
+/** e.g. "SGD ($)" or "INR (₹)": the code plus the sign shown on amounts. */
+export function getCurrencyLabel(code: string): string {
+  const sign = getDisplayedSymbol(code)
+  return sign === code ? code : `${code} (${sign})`
+}
